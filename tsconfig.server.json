{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist/node",
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/game/**/*.ts", "src/shared/**/*.ts"]
}
